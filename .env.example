# Copy the approved configuration from BMM Developers. This default is for local BMM.
BMM_ORIGIN=http://localhost:3080
BMM_CLIENT_ID=
BMM_API_KEY=
# Use your exact approved callback and its origin (localhost HTTP only in sandbox).
APP_ORIGIN=http://localhost:3090
BMM_REDIRECT_URI=http://localhost:3090/api/bmm/callback
# Optional: BMM → Developers → select your approved app → Sample data preview
# → Generate preview token. Copy the BMM-issued token below (no CLI generation).
# Use the same app as BMM_CLIENT_ID / BMM_API_KEY. Expires in 7 days.
# Enables only the optional /preview page; Connect BMM remains the main flow.
# Server-only; never use NEXT_PUBLIC_.
BMM_DEMO_TOKEN=
